extends Node
# Music and sound effects (v0.31). Music crossfades between menu/shop, game and boss tracks and
# ducks while paused. Effects play from a small pool so they can overlap. Everything follows
# GameManager.sound / master volume (the Master bus); music also follows GameManager.music.
# Audio files are generated by tools/generate_audio.gd.
const TRACKS: Dictionary = {"shop":"music_shop","game":"music_game","boss":"music_boss"}
const MUSIC_DB: float = -9.0
const DUCK_DB: float = -18.0
const SILENT_DB: float = -60.0
const FADE: float = 0.7
const POOL: int = 10
var music_players: Array[AudioStreamPlayer] = []
var active: int = 0
var current: String = ""
var ducked: bool = false
var sfx_pool: Array[AudioStreamPlayer] = []
var next_sfx: int = 0
var streams: Dictionary = {}
var last_tick: int = 0
var last_played: Dictionary = {}

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i: int in range(2):
		var player: AudioStreamPlayer = AudioStreamPlayer.new()
		player.volume_db = SILENT_DB
		add_child(player)
		music_players.append(player)
	for i: int in range(POOL):
		var player: AudioStreamPlayer = AudioStreamPlayer.new()
		add_child(player)
		sfx_pool.append(player)
	GameManager.round_started.connect(_on_round_started)
	GameManager.shop_opened.connect(_on_shop_opened)
	GameManager.run_ended.connect(_on_run_ended)
	GameManager.sfx.connect(_on_sfx)
	# Every button in the game clicks.
	get_tree().node_added.connect(_on_node_added)

func _on_round_started() -> void:
	var boss: bool = GameManager.curse() != "none"
	play_track("boss" if boss else "game")
	if boss: play("boss")

func _on_shop_opened() -> void:
	play_track("shop")
	play("skip" if GameManager.shop_closed else "round_win")

func _on_run_ended(won: bool) -> void:
	stop_music()
	play("victory" if won else "defeat")

func _on_sfx(sfx_name: String) -> void:
	play(sfx_name)

func _on_node_added(node: Node) -> void:
	if node is BaseButton:
		(node as BaseButton).pressed.connect(_on_button_pressed)

func _on_button_pressed() -> void:
	play("click",1.0,-4.0)

func load_stream(file_name: String) -> AudioStream:
	if not streams.has(file_name):
		# Music loops seamlessly via its import settings (edit/loop_mode=2).
		streams[file_name] = load("res://assets/audio/"+file_name+".wav") as AudioStream
	return streams[file_name]

# Play a sound effect by name without the "sfx_" prefix (e.g. "coin"), with optional pitch and gain.
# The same effect is throttled to once per 40 ms so big cascades stay pleasant.
func play(sfx_name: String, pitch: float = 1.0, volume_db: float = 0.0) -> void:
	if not GameManager.sound: return
	var now: int = Time.get_ticks_msec()
	if now-int(last_played.get(sfx_name,-1000)) < 40: return
	last_played[sfx_name] = now
	var stream: AudioStream = load_stream("sfx_"+sfx_name)
	if stream == null: return
	var player: AudioStreamPlayer = sfx_pool[next_sfx]
	next_sfx = (next_sfx+1)%sfx_pool.size()
	player.stream = stream
	player.pitch_scale = clampf(pitch,0.5,2.5)
	player.volume_db = volume_db
	player.play()

# Short score-count ticks that rise in pitch as the round score climbs toward the quota.
func tick(progress: float) -> void:
	var now: int = Time.get_ticks_msec()
	if now-last_tick < 55: return
	last_tick = now
	play("tick",1.0+clampf(progress,0.0,1.0)*0.8,-8.0)

func play_track(track: String) -> void:
	if track == current: return
	current = track
	var outgoing: AudioStreamPlayer = music_players[active]
	active = 1-active
	var incoming: AudioStreamPlayer = music_players[active]
	incoming.stream = load_stream(TRACKS[track])
	incoming.volume_db = SILENT_DB
	incoming.play()
	var fade: Tween = create_tween().set_parallel()
	fade.tween_property(incoming,"volume_db",target_db(),FADE)
	fade.tween_property(outgoing,"volume_db",SILENT_DB,FADE)
	fade.chain().tween_callback(_stop_if_inactive.bind(outgoing))

func _stop_if_inactive(player: AudioStreamPlayer) -> void:
	if player != music_players[active]: player.stop()

func stop_music() -> void:
	current = ""
	for player: AudioStreamPlayer in music_players:
		create_tween().tween_property(player,"volume_db",SILENT_DB,FADE)

func target_db() -> float:
	if not GameManager.music: return -80.0
	return DUCK_DB if ducked else MUSIC_DB

# Quieter music while paused.
func set_ducked(value: bool) -> void:
	ducked = value
	refresh_volume()

# Re-apply the Music on/off setting and ducking to the playing track.
func refresh_volume() -> void:
	if current.is_empty(): return
	create_tween().tween_property(music_players[active],"volume_db",target_db(),0.25)
