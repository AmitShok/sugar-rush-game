extends "res://tests/consumable_runner.gd"
func run_tests() -> void:
 for locale: String in ["he","ar","en"]:
  TranslationServer.set_locale(locale)
  GameManager.state="menu"
  main=preload("res://scenes/MainGame.tscn").instantiate()
  add_child(main)
  await frames()
  check(not main.is_layout_rtl(),locale+": English interface keeps left-to-right geometry")
  await click(main.get_node("Menu/Layout/Play"))
  var content: Control=main.route.get_node("Content")
  check(main.route.visible,locale+": New Run opens the route")
  check(content.get_global_rect()==Rect2(146,48,860,648),locale+": Route stays in its intended on-screen position")
  check(Rect2(0,0,1152,720).encloses(main.route.enter_button.get_global_rect()),locale+": Round confirmation stays on-screen")
  await capture(locale+"_route")
  await click(main.route.back_button)
  await click(main.get_node("Menu/Layout/Collection"))
  check(main.collection.visible and not main.collection.is_layout_rtl(),locale+": Collection inherits the intended direction")
  check(Rect2(0,0,1152,720).encloses(main.collection.grid.get_global_rect()) and Rect2(0,0,1152,720).encloses(main.collection.portrait.get_global_rect()),locale+": Collection cards and details remain on-screen")
  await capture(locale+"_collection")
  await click(main.collection.back)
  await click(main.get_node("Menu/Layout/Play"))
  await click(main.route.enter_button)
  check(GameManager.state=="playing" and not main.route.visible,locale+": Physical clicks start a playable round")
  check(not main.board.is_layout_rtl(),locale+": Board direction agrees with logical input")
  await frames()
  if FileAccess.file_exists(main.run_save.path): DirAccess.remove_absolute(main.run_save.path)
  main.queue_free()
  await frames()
 print("RESULT: %s locale checks, %s failures" % [checks,failures])
 get_tree().quit(1 if failures else 0)
